# Base URL of the FastAPI backend. Leave empty to run the UI on built-in demo data.
VITE_API_BASE_URL=
# "browser" (default, needs server-side SPA fallback) or "hash" (static hosting)
VITE_ROUTER_MODE=browser
# Public key only. Payment SECRETS must live on the backend, never here.
VITE_PAYMENT_PUBLIC_KEY=
VITE_SITE_URL=https://www.example.org
