# ---- Copy to .env and fill in. NEVER commit real values. ----
APP_ENV=development
SITE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://udaan:change-me@localhost:5432/udaan

# Long random string (e.g. `python -c "import secrets;print(secrets.token_urlsafe(64))"`)
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Payment gateway (Razorpay-style). SECRET values stay on the server only.
PAYMENT_GATEWAY=razorpay
PAYMENT_KEY_ID=rzp_test_xxxxxxxx
PAYMENT_KEY_SECRET=change-me
PAYMENT_WEBHOOK_SECRET=change-me

# Object storage (S3-compatible: AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO)
STORAGE_BUCKET=udaan-media
STORAGE_PUBLIC_BASE_URL=https://cdn.example.org
STORAGE_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Transactional email (SES / SendGrid / Postmark via SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Udaan Seva Foundation <no-reply@example.org>"
